 //lectura de archivos :>
 
 /**
  * Lee "Alumnos.txt" y "Solicitudes.txt" y carga la informacion en los
  * vectores estaticos. 
  * Si algun archivo no existe o alguna linea viene mal formada, 
  * se avisa por consola pero el programa jamas se cae
  */
 static void cargarArchivos() {
     alCount = 0;
     solCount = 0;
     alumnosCargados = false;
     solicitudesCargadas = false;

     cargarAlumnosDesdeArchivo();
     cargarSolicitudesDesdeArchivo();
static void cargarAlumnosDesdeArchivo() {
     File archivo = new File(archAlumnos);
     if (!archivo.exists()) {
         System.out.println("No se encontro el archivo " + archAlumnos + ".");
         return;
     }
     try (Scanner lector = new Scanner(archivo)) {
         while (lector.hasNextLine()) {
             String linea = lector.nextLine().trim();
             if (linea.isEmpty()) continue;

             String[] partes = linea.split(";", -1);
             if (partes.length != 4) {
                 System.out.println("Linea con formato invalido en " + archAlumnos + ", se omite: " + linea);
                 continue;
             }
             String nombre = partes[0].trim();
             String apellido = partes[1].trim();
             String rut = partes[2].trim();
             String paralelo = partes[3].trim().toUpperCase();

             if (nombre.isEmpty() || apellido.isEmpty() || rut.isEmpty()) {
                 System.out.println("Linea con campos vacios en " + archAlumnos + ", se omite: " + linea);
                 continue;
             }
             if (!paralelo.equals("C1") && !paralelo.equals("C2")) {
                 System.out.println("Paralelo invalido en " + archAlumnos + ", se omite: " + linea);
                 continue;
             }
             if (alCount >= max) {
                 System.out.println("Capacidad maxima de alumnos (" + max + ") alcanzada, se ignoran las lineas restantes.");
                 break;
             }
             alNombre[alCount] = nombre;
             alApellido[alCount] = apellido;
             alRut[alCount] = rut;
             alParalelo[alCount] = paralelo;
             alCount++;
         }
         alumnosCargados = true;
     } catch (IOException e) {
         System.out.println("Error al leer " + archAlumnos + ": " + e.getMessage());
     }
 }

     System.out.println("Archivos cargados con exito!");
     System.out.println("- " + alCount + " alumnos en la lista.");
     System.out.println("- " + solCount + " solicitudes de ingreso.");
 }
static void cargarSolicitudesDesdeArchivo() {
     File archivo = new File(archSolicitudes);
     if (!archivo.exists()) {
         System.out.println("No se encontro el archivo " + archSolicitudes + ".");
         return;
     }
     try (Scanner lector = new Scanner(archivo)) {
         while (lector.hasNextLine()) {
             String linea = lector.nextLine().trim();
             if (linea.isEmpty()) continue;

             int guion = linea.indexOf('-');
             if (guion <= 0 || guion == linea.length() - 1) {
                 System.out.println("Linea con formato invalido en " + archSolicitudes + ", se omite: " + linea);
                 continue;
             }
             if (solCount >= max) {
                 System.out.println("Capacidad maxima de solicitudes (" + max + ") alcanzada, se ignoran las lineas restantes.");
                 break;
             }
             solNombre[solCount] = linea.substring(0, guion).trim();
             solApellido[solCount] = linea.substring(guion + 1).trim();
             solProcesada[solCount] = false;
             solCount++;
         }
         solicitudesCargadas = true;
     } catch (IOException e) {
         System.out.println("Error al leer " + archSolicitudes + ": " + e.getMessage());
     }
 }
 //Procesar las solicitudes
 
 /**
  * Recorre las solicitudes aun no procesadas y las compara contra la
  * lista de alumnos (nombre + apellido, sin distinguir mayusculas)
  */
 static void procesarSolicitudes() {
     if (!alumnosCargados || !solicitudesCargadas) {
         System.out.println("Debe cargar los archivos (opcion 1) antes de procesar solicitudes.");
         return;
     }
     System.out.println("Procesando solicitudes...\n");

     int admitidosNuevos = 0, rechazadosNuevos = 0, duplicados = 0;
     for (int i = 0; i < solCount; i++) {
         if (solProcesada[i]) continue; // ya se proceso en una corrida anterior
         solProcesada[i] = true;

         int idxAlumno = buscarAlumnoPorNombre(solNombre[i], solApellido[i]);
         if (idxAlumno == -1) {
             agregarRechazado(solNombre[i] + " " + solApellido[i] + " - No pertenece a ningun paralelo del curso");
             System.out.println("[RECHAZO]  " + solNombre[i] + " " + solApellido[i] + " -> no pertenece a ningun paralelo");
             rechazadosNuevos++;
             continue;
         }

         String rut = alRut[idxAlumno];
         if (esMiembro(rut)) {
             System.out.println("[DUPLICADO] " + solNombre[i] + " " + solApellido[i] + " -> ya es miembro del grupo");
             duplicados++;
             continue;
         }

         if (agregarMiembro(alNombre[idxAlumno], alApellido[idxAlumno], rut, alParalelo[idxAlumno])) {
             statArchivoAdmitidos++;
             admitidosNuevos++;
             System.out.println("[OK]       " + alNombre[idxAlumno] + " " + alApellido[idxAlumno] + " -> admitido en " + alParalelo[idxAlumno]);
         } else {
             System.out.println("[ERROR]    No hay espacio en el grupo para admitir a " + alNombre[idxAlumno] + " " + alApellido[idxAlumno]);
         }
     }

     System.out.print("\nResumen: " + admitidosNuevos + " admitidos / " + rechazadosNuevos + " rechazados");
     System.out.println(duplicados > 0 ? " / " + duplicados + " ya eran miembros." : ".");
 }
//inscripcion manual
 
 static void inscripcionManual() {
     if (!alumnosCargados) {
         System.out.println("Debe cargar los archivos (opcion 1) antes de inscribir manualmente.");
         return;
     }
     System.out.println("Como desea inscribir a la persona?");
     System.out.println("1) Por nombre completo");
     System.out.println("2) Por RUT");
     System.out.println("0) Cancelar");
     int op = leerEntero("Ingrese opcion: ", 0, 2);
     if (op == 0) return;

     statManualIntentos++;
     if (op == 1) {
         inscribirManualPorNombre();
     } else {
         inscribirManualPorRut();
     }
 }

 static void inscribirManualPorNombre() {
     String nombre = leerTexto("Ingrese nombre: ");
     String apellido = leerTexto("Ingrese apellido: ");
     if (nombre.isEmpty() || apellido.isEmpty()) {
         System.out.println("Nombre y apellido no pueden estar vacios. Operacion cancelada.");
         return;
     }
     int idx = buscarAlumnoPorNombre(nombre, apellido);
     if (idx == -1) {
         agregarRechazado(nombre + " " + apellido + " - No pertenece a ningun paralelo del curso");
         System.out.println("La persona " + nombre + " " + apellido + " no pertenece a ningun paralelo del curso.");
         System.out.println("Se registro en los rechazados.");
         return;
     }
     admitirPorInscripcionManual(idx);
 }

 static void inscribirManualPorRut() {
     String rut = leerTexto("Ingrese RUT: ");
     if (rut.isEmpty()) {
         System.out.println("El RUT no puede estar vacio. Operacion cancelada.");
         return;
     }
     int idx = buscarAlumnoPorRut(rut);
     if (idx == -1) {
         agregarRechazado("Sin nombre registrado, RUT: " + rut);
         statRutSoloRechazos++;
         System.out.println("El RUT " + rut + " no pertenece a ningun paralelo del curso.");
         System.out.println("No tenemos su nombre, por lo que se registrara solo el RUT en los rechazados.");
         return;
     }
     admitirPorInscripcionManual(idx);
 }
 
 /** Admite (si corresponde) al alumno en la posicion idx del vector de alumnos */
 static void admitirPorInscripcionManual(int idx) {
     if (esMiembro(alRut[idx])) {
         System.out.println(alNombre[idx] + " " + alApellido[idx] + " ya es miembro del grupo.");
         return;
     }
     if (agregarMiembro(alNombre[idx], alApellido[idx], alRut[idx], alParalelo[idx])) {
         statManualAdmitidos++;
         System.out.println(alNombre[idx] + " " + alApellido[idx] + " fue admitido en " + alParalelo[idx] + " (inscripcion manual).");
     } else {
         System.out.println("No hay espacio en el grupo para admitir a esta persona.");
     }
 }
