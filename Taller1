 static void inscribirManualPorRut() {
     String rut = leerTexto("Ingrese RUT: ");
     if (rut.isEmpty()) {
         System.out.println("El RUT no puede estar vacio. Operacion cancelada.");
         return;
     }
     int idx = buscarAlumnoPorRut(rut);
     if (idx == -1) {
         agregarRechazado("Sin nombre registrado, RUT: " + rut);
         statRutSoloRechazos++;
         System.out.println("El RUT " + rut + " no pertenece a ningun paralelo del curso.");
         System.out.println("No tenemos su nombre, por lo que se registrara solo el RUT en los rechazados.");
         return;
     }
     admitirPorInscripcionManual(idx);
 }
 
 /** Admite (si corresponde) al alumno en la posicion idx del vector de alumnos */
 static void admitirPorInscripcionManual(int idx) {
     if (esMiembro(alRut[idx])) {
         System.out.println(alNombre[idx] + " " + alApellido[idx] + " ya es miembro del grupo.");
         return;
     }
     if (agregarMiembro(alNombre[idx], alApellido[idx], alRut[idx], alParalelo[idx])) {
         statManualAdmitidos++;
         System.out.println(alNombre[idx] + " " + alApellido[idx] + " fue admitido en " + alParalelo[idx] + " (inscripcion manual).");
     } else {
         System.out.println("No hay espacio en el grupo para admitir a esta persona.");
     }
 }
