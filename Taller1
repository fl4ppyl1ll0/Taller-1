     String nombre = leerTexto("Ingrese nombre: ");
     String apellido = leerTexto("Ingrese apellido: ");
     String rut = leerTexto("Ingrese RUT: ");
     String paralelo = leerTexto("Ingrese paralelo (C1/C2): ").toUpperCase();

     if (nombre.isEmpty() || apellido.isEmpty() || rut.isEmpty()) {
         System.out.println("Los campos no pueden quedar en blanco. Operacion cancelada.");
