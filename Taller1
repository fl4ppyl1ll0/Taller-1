 /** Calcula el siguiente numero de version libre para un prefijo de archivo dado */
 static File siguienteArchivoVersionado(File carpeta, String prefijo) {
     int version = 1;
     File archivo;
     do {
         archivo = new File(carpeta, prefijo + "-V" + version + ".txt");
         version++;
     } while (archivo.exists());
     return archivo;
 }
static void generarReporteParalelo(String paralelo) {
     File carpeta = new File(carpetaReportes);
     if (!carpeta.exists() && !carpeta.mkdirs()) {
         System.out.println("No se pudo crear la carpeta " + carpetaReportes + ".");
         return;
     }
     File archivo = siguienteArchivoVersionado(carpeta, "Reporte" + paralelo);

     try (BufferedWriter bw = new BufferedWriter(new FileWriter(archivo))) {
         bw.write("=== Miembros del grupo - Paralelo " + paralelo + " ===");
         bw.newLine();
         for (int i = 0; i < miCount; i++) {
             if (miParalelo[i].equalsIgnoreCase(paralelo)) {
                 bw.write(miNombre[i] + " " + miApellido[i] + " - " + miRut[i]);
                 bw.newLine();
             }
         }
         System.out.println("Reporte generado: " + archivo.getPath());
     } catch (IOException e) {
         System.out.println("Error al generar el reporte: " + e.getMessage());
     }
 }


