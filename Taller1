/** Reescribe "Alumnos.txt" completo a partir de los vectores en memoria. */
 static boolean guardarAlumnos() {
     try (BufferedWriter bw = new BufferedWriter(new FileWriter(archAlumnos))) {
         for (int i = 0; i < alCount; i++) {
             bw.write(alNombre[i] + ";" + alApellido[i] + ";" + alRut[i] + ";" + alParalelo[i]);
             bw.newLine();
         }
         return true;
     } catch (IOException e) {
         System.out.println("Error al guardar " + archAlumnos + ": " + e.getMessage());
         return false;
     }
 }
